# ============================================================
# STR Operations App — environment variable template
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
# NEVER put the service_role key in this file or in client code.
# ============================================================

# Supabase — staging project (str-ops-staging)
# Find these at: supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# NOTE: The service_role key is NOT listed here.
# It belongs only in server-side Edge Functions via Supabase Vault.
# See docs/DEPLOYMENT_GUIDE.md for the rules on secrets handling.
